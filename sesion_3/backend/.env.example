# ============================================================
# Sesión 3 — Variables de Entorno de Ejemplo
# ============================================================
# 1. Copia este archivo:  cp .env.example .env
# 2. Edita los valores según tu entorno
# 3. NUNCA suba .env a git (ya está en .gitignore)
# ============================================================

# ── Aplicación ──────────────────────────────────────────────
APP_NAME="LLM Security Lab · Sesión 3"
VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development    # development | staging | production

# ── JWT — CAMBIAR EN PRODUCCIÓN ──────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIA_ESTE_SECRETO_EN_PRODUCCION_abc123xyz789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=10

# ── Circuit Breaker ──────────────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=30

# ── Ollama ───────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Audit Log ────────────────────────────────────────────────
AUDIT_LOG_PATH=logs/audit.jsonl

# ── GCP (solo si usa Vertex AI en T6) ───────────────────────
GCP_PROJECT_ID=tu-proyecto-gcp
GCP_REGION=us-central1
VERTEX_AI_ENDPOINT=
